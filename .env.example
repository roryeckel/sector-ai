# Copy to .env and fill in the token. Everything here is optional except the
# token, and every value can also be passed as a real environment variable.
# Nested names use a double underscore, e.g. SECTOR_AI_SYSTEM_PROMPTS__SVG.

# Required. Get one from @BotFather.
TELEGRAM_BOT_TOKEN=

# Ollama endpoint. Inside Docker on Linux, use http://host.docker.internal:11434
# together with `extra_hosts: ["host.docker.internal:host-gateway"]`.
OLLAMA_URL=http://localhost:11434

SECTOR_AI_DEFAULT_MODEL=llama3.2-vision:11b-instruct-fp16
SECTOR_AI_VISION_MODEL=llama3.2-vision:11b-instruct-fp16
SECTOR_AI_DEFAULT_SVG_SIZE=250
SECTOR_AI_LOG_LEVEL=INFO

# Comma separated. Replaces the built-in default of "ex0dus".
SECTOR_AI_ADMIN_USERNAMES=ex0dus

SECTOR_AI_STREAMING_CURSOR=🦙
SECTOR_AI_STREAMING_INTERVAL_SEC=0.7
SECTOR_AI_STREAMING_CHUNK_SIZE=150

SECTOR_AI_OLLAMA_TIMEOUT=200.0
# 2048 by default; set to null to leave the context length to the model.
SECTOR_AI_OLLAMA_CONTEXT_LENGTH=2048
# Comma separated model names hidden from /models.
SECTOR_AI_OLLAMA_DISALLOWED_MODELS=
# JSON object sent as extra HTTP headers to Ollama.
SECTOR_AI_OLLAMA_HEADERS={}

# System prompts can be overridden individually:
# SECTOR_AI_SYSTEM_PROMPTS__SVG=Respond only with simple SVG.
# SECTOR_AI_SYSTEM_PROMPTS__DEFAULT=You are a helpful assistant.
