# Copy to .env and fill in the token. Everything here is optional except the
# token, and every value can also be passed as a real environment variable.
# Nested names use a double underscore, e.g. SECTOR_AI_SYSTEM_PROMPTS__SVG.

# Required. Get one from @BotFather.
TELEGRAM_BOT_TOKEN=

# Backend: "ollama" (native API) or "openai" (any OpenAI-compatible /v1 endpoint).
SECTOR_AI_LLM_PROVIDER=ollama

# Ollama endpoint, used by the ollama provider. Inside Docker on Linux, use
# http://host.docker.internal:11434 together with
# `extra_hosts: ["host.docker.internal:host-gateway"]`.
OLLAMA_URL=http://localhost:11434

# OpenAI-compatible endpoint, used by the openai provider. Must include /v1;
# examples: http://localhost:11434/v1, http://localhost:1234/v1,
# https://openrouter.ai/api/v1.
# SECTOR_AI_OPENAI_BASE_URL=http://localhost:11434/v1
# Leave empty for local servers. An empty value sends "dummy", which they ignore.
# SECTOR_AI_OPENAI_API_KEY=

SECTOR_AI_DEFAULT_MODEL=llama3.2-vision:11b-instruct-fp16
SECTOR_AI_DEFAULT_SVG_SIZE=250

# Photos join the normal conversation. When the default model reads images
# they are sent inline. Set DEFAULT_MODEL_VISION=false for a text-only model:
# then VISION_MODEL (optional) describes each photo, and without it the
# conversation only records a placeholder.
# SECTOR_AI_DEFAULT_MODEL_VISION=true
# SECTOR_AI_VISION_MODEL=
# Largest Telegram photo size to send (longest side, pixels).
# SECTOR_AI_IMAGE_MAX_SIDE=1280
# Photos from earlier messages kept attached after a compaction.
# SECTOR_AI_IMAGE_HISTORY_LIMIT=4
# Safety cap on attached photos per request (0 = none; in native photo mode
# this needs compaction on, or photos would never be released from memory).
# Lower it to match a
# server limit such as vLLM's --limit-mm-per-prompt.
# SECTOR_AI_IMAGE_MAX_ATTACHED=32
# Pixels per image token for local estimates (28 suits Qwen-VL; 32 for Qwen3-VL).
# SECTOR_AI_IMAGE_PATCH_PX=28
# GIFs arrive as short MP4s and are sampled into still frames. Needs ffmpeg;
# without it, or when a clip is too large or cannot be decoded, only the still
# thumbnail is kept and the marker says so. 0 frames means still-only.
# SECTOR_AI_GIF_MAX_FRAMES=8
# SECTOR_AI_GIF_FRAME_SIDE=480
# SECTOR_AI_GIF_MAX_BYTES=15728640
# SECTOR_AI_GIF_TIMEOUT=20.0
# SECTOR_AI_FFMPEG_PATH=ffmpeg
# Seconds to collect an album before answering it as one turn.
# SECTOR_AI_ALBUM_WAIT=1.5
# Restarts allowed when a newer relevant message (or an edit) arrives before the
# bot has replied. 0 disables debouncing.
# SECTOR_AI_DEBOUNCE_MAX_RESTARTS=3
SECTOR_AI_LOG_LEVEL=INFO

# Comma separated. Replaces the built-in default of "ex0dus".
SECTOR_AI_ADMIN_USERNAMES=ex0dus

SECTOR_AI_STREAMING_CURSOR=🦙
SECTOR_AI_STREAMING_INTERVAL_SEC=0.7
SECTOR_AI_STREAMING_CHUNK_SIZE=150

# Render model markdown as Telegram formatting (bold, code, lists, quotes).
# Replies over Telegram's 4096-character limit are split automatically.
# SECTOR_AI_MARKDOWN=true

SECTOR_AI_LLM_TIMEOUT=200.0
# Comma separated model names hidden from /models.
SECTOR_AI_LLM_DISALLOWED_MODELS=
# JSON object sent as extra HTTP headers.
SECTOR_AI_LLM_HEADERS={}

# Prompt caching. "auto" sends controls only to recognized OpenAI/OpenRouter
# endpoints; self-hosted compatible servers keep their own prefix cache.
# Modes: auto, off, openai, openrouter.
# SECTOR_AI_PROMPT_CACHE_MODE=auto
# SECTOR_AI_PROMPT_CACHE_KEY_PREFIX=sector-ai
# OpenAI only, models before GPT-5.6: "", in_memory, or 24h.
# SECTOR_AI_PROMPT_CACHE_RETENTION=
# OpenAI (GPT-5.6+): 30m. OpenRouter: 1h extends Anthropic-style automatic
# caching. With a retention value also set, this wins and retention is not
# sent (OpenAI rejects both); a startup warning says so.
# SECTOR_AI_PROMPT_CACHE_TTL=
# Ask compatible servers to include token usage in stream chunks. Off by
# default because older local servers reject stream_options.
# SECTOR_AI_STREAM_USAGE=false

# Autonomous SVG, HTML, poll and explicitly allowlisted MCP tools.
# Set false for plain chat; /svg, /html, /poll and /topic still work.
# Models without tool calling fall back to plain chat automatically.
# SECTOR_AI_AGENT_TOOLS_ENABLED=true
# Tool-free engagement decisions see up to 8 recent messages, the summary,
# current UTC time, chat/topic labels, reply targets and observed service events.
# SECTOR_AI_AUTOREPLY_HISTORY_MESSAGES=8
# SECTOR_AI_AUTOREPLY_CONTEXT_TOKENS=1536
# SECTOR_AI_AGENT_MAX_TOOL_CALLS=6
# SECTOR_AI_AGENT_MAX_ITERATIONS=8
# SECTOR_AI_AGENT_TIMEOUT=240
# SECTOR_AI_TOOL_TIMEOUT=90
# SECTOR_AI_TOOL_RESULT_MAX_CHARS=16000

# Optional MCP-only JSON configuration. See mcp.example.json and docs/agent.md.
# No tools are imported without an explicit allowed_tools list.
# SECTOR_AI_MCP_CONFIG=mcp.json

# Context window in tokens. 0 detects it from the server (OpenAI-compatible
# /v1/models or Ollama /api/ps and /api/show) and falls back to 8192.
# SECTOR_AI_CONTEXT_LENGTH=0

# Fold older messages into a summary as the context fills up.
# SECTOR_AI_COMPACTION_ENABLED=true
# SECTOR_AI_COMPACTION_THRESHOLD=0.75
# SECTOR_AI_COMPACTION_KEEP_MESSAGES=8
# SECTOR_AI_COMPACTION_MAX_MESSAGES=500
# SECTOR_AI_COMPACTION_SUMMARY_MAX_CHARS=4000

# System prompts can be overridden individually:
# SECTOR_AI_SYSTEM_PROMPTS__SVG=Respond only with simple SVG.
# SECTOR_AI_SYSTEM_PROMPTS__DEFAULT=You are a helpful assistant.
